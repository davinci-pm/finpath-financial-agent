# === Supabase（阶段 3 启用）===
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# === AI Provider（阶段 4/5 启用）===
AI_TEXT_PROVIDER=deepseek
AI_DOCUMENT_PROVIDER=deepseek

# DeepSeek（默认文本模型）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_DOCUMENT=deepseek-v4-flash-vision-exp

# OpenAI（文档解析 / 备用文本模型）
OPENAI_API_KEY=
OPENAI_MODEL_TEXT=
OPENAI_MODEL_DOCUMENT=gpt-4o

# === 通用 ===
MAX_UPLOAD_MB=4
APP_ENV=development

# === Vercel 邀请制内测（生产必需）===
# APP_ENV=production 时，服务端强制邀请码登录并使用 Private Blob 持久化。
SESSION_SECRET=
SESSION_DAYS=30
INVITE_CODE_RECORDS=[]

# Vercel Private Blob：创建并连接 Blob 后由 Vercel 自动注入 Token。
BLOB_READ_WRITE_TOKEN=
BLOB_PREFIX=finpath-beta
